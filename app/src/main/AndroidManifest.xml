<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Non-negotiable (spec §2.1): no INTERNET permission, ever. Do not add one.
        Enforced by the Gradle guard in E1.I2.

        E3.I1 manifest security baseline (spec §9): the permission set is
        exactly {POST_NOTIFICATIONS, USE_BIOMETRIC} — both are normal/runtime
        permissions for features landing later (SecureNotification, biometric
        unlock in E3.I2/E3.I4), declared now so ManifestPolicyTest locks the
        final posture in place. Neither is network-related and neither trips
        the ManifestGuardTask denylist (INTERNET, ACCESS_NETWORK_STATE only).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
        E5.I10 (skein-7v3): androidx.work:work-runtime merges four
        uses-permissions of its own. None is needed by the ingest worker's
        usage and one (ACCESS_NETWORK_STATE) is on the manifest guard's
        denylist, so all four are removed from the merged manifest:
          - ACCESS_NETWORK_STATE: only consulted by WorkManager's network
            constraint tracker, which is never registered because
            `IngestWorker` runs with `NetworkType.NOT_REQUIRED`
            (LOCK_POLICY_INDEXING.md §3.2: no constraints gate at all).
          - RECEIVE_BOOT_COMPLETED: WorkManager's boot receiver would only
            reschedule persisted work after a reboot; the vault is locked
            after a reboot and `IngestScheduler` re-enqueues on unlock
            (invariant I2, §6.1), so nothing may run from boot.
          - FOREGROUND_SERVICE: expedited/foreground work is not used
            (on API 30 it would need a foreground service + notification).
          - WAKE_LOCK: only acquired by the pre-API-23 alarm scheduler and
            the foreground-service path; minSdk is 30 and neither is used.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WAKE_LOCK"
        tools:node="remove" />

    <!--
        skein-2ige: SkeinApplication is the :app process's composition root
        for the vault stack (UnlockManager → VaultBootstrap → open-vault
        services → VaultDocumentsProvider). The isolated processes below get
        the same class by manifest but never touch it.
    -->
    <application
        android:name="app.skein.SkeinApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules_legacy"
        android:hasFragileUserData="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name="app.skein.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Isolated inference process (spec §2.6, §4.1). No Android permissions
            reach this process. AIDL binder + llama.cpp bridge land in E1.I4 / E4.I1+.
        -->
        <service
            android:name="app.skein.inference.service.InferenceService"
            android:process=":inference"
            android:isolatedProcess="true"
            android:exported="false" />

        <!--
            Isolated embedder process (spec §4.1). ONNX Runtime pipelines land in E5.I1+.
        -->
        <service
            android:name="app.skein.embedder.service.EmbedderService"
            android:process=":embedder"
            android:isolatedProcess="true"
            android:exported="false" />

        <!--
            E2.I6 (spec §2.9/§9; docs/design/POST_REVIEW_RESOLUTIONS.md §4.3,
            skein-7ki2): the ONE way vault content reaches other apps — a
            DocumentsProvider behind the system file picker. No FileProvider
            anywhere in the shipped app (§4 v1 acceptance criterion).

            exported="true" + permission=MANAGE_DOCUMENTS is what the platform
            requires of every DocumentsProvider (DocumentsProvider.attachInfo
            refuses anything else; only the system DocumentsUI holds
            MANAGE_DOCUMENTS). grantUriPermissions="false" together with the
            two <grant-uri-permission> subsets means the effective
            ProviderInfo allows grants ONLY for /document/note:* and
            /document/att:* paths — never a tree/root/directory URI — so no
            client can end up holding a grant over the whole vault. Persistable
            grants and the exported-components audit: E10.I9. The class itself
            refuses everything while the vault is locked.
        -->
        <provider
            android:name="app.skein.core.vault.provider.VaultDocumentsProvider"
            android:authorities="us.aherrera.skein.documents"
            android:exported="true"
            android:grantUriPermissions="false"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
            <!-- v1.1 ad-hoc share grants will target these same prefixes (§4.2). -->
            <grant-uri-permission android:pathPrefix="/document/note:" />
            <grant-uri-permission android:pathPrefix="/document/att:" />
        </provider>

        <!--
            E3.I1 (spec §9): androidx.profileinstaller ships an exported
            BroadcastReceiver so `pm compile` / Play's install-time delivery
            can trigger baseline-profile compilation. This app is never
            distributed through Play (spec §10) and the manifest baseline
            requires zero exported components, so the merged component is
            removed outright rather than merely marked exported="false".
        -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />

        <!--
            E5.I10 (skein-7v3): work-runtime merges an exported
            DiagnosticsReceiver (DUMP-permission-guarded `adb` hook that
            dumps WorkManager's database) — a debugging surface Skein never
            uses, removed to keep the "no exported receiver" baseline. The
            one WorkManager component that stays exported is
            `androidx.work.impl.background.systemjob.SystemJobService`,
            which JobScheduler *must* bind to and which is guarded by the
            system-signature permission BIND_JOB_SERVICE — see
            ManifestPolicyTest for the corresponding allowance.
        -->
        <receiver
            android:name="androidx.work.impl.diagnostics.DiagnosticsReceiver"
            tools:node="remove" />

        <!--
            E5.I10 (skein-7v3): on-demand WorkManager initialization —
            SkeinApplication implements Configuration.Provider (custom
            WorkerFactory for IngestWorker), so WorkManager's automatic
            androidx.startup initializer is removed. The provider element
            itself stays merged: lifecycle-process's ProcessLifecycleInitializer
            (LockPolicyObserver's foreground/background trigger) still runs
            through it.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
