<?xml version="1.0" encoding="utf-8"?>
<!--
    skein-t9h2: adaptive icon (API 26+). Foreground/monochrome PNGs are
    generated per-density by tools/icons/generate_launcher_icons.py from
    docs/branding/skein-icon-app-logo.png; the background is a flat colour
    sampled from the same artwork (see values/colors.xml).
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
