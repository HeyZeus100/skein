<?xml version="1.0" encoding="utf-8"?>
<!--
    skein-t9h2: round adaptive icon (API 26+). Same layers as
    ic_launcher.xml: the foreground/background are already inset to the
    108dp/66dp adaptive-icon safe zone, so both the square and round
    variants share identical drawables; the launcher applies its own mask
    shape (circle, squircle, etc.) on top.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
