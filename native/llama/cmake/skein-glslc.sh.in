#!/bin/sh
# GENERATED by native/llama/CMakeLists.txt §5a (bd skein-ylux) from
# native/llama/cmake/skein-glslc.sh.in. Do not hand-edit; edit the template.
#
# ggml-vulkan hard-codes its shader source directory
# (`${CMAKE_CURRENT_SOURCE_DIR}/vulkan-shaders`, inside the submodule) and we
# never write into `third_party/`. The one interception point we own is
# `Vulkan_GLSLC_EXECUTABLE`, which native/llama/CMakeLists.txt pre-seeds
# before `add_subdirectory(llama.cpp)`. This wrapper is what that variable
# points at: it rewrites any argument naming a file under the pristine shader
# directory to the patched copy in the build tree, then execs the NDK's real
# glslc. Every other argument is passed through untouched, in order.
#
# It is deliberately dumb: no retries, no caching, no flag rewriting. The one
# piece of cleverness is the guard below -- if a shader source ever reaches
# this wrapper from somewhere other than the patched tree (because upstream
# moved the directory, or the two absolute paths stopped being spelled the
# same way), the build FAILS here rather than quietly compiling the unpatched
# source and reintroducing bd skein-ylux.
set -e

orig='@SKEIN_GLSLC_ORIG_DIR@'
patched='@SKEIN_GLSLC_PATCHED_DIR@'

# Rotate argv: pop the front argument, push the (possibly rewritten) value on
# the back, $# times. POSIX, no arrays, preserves empty arguments.
n=$#
i=0
while [ "$i" -lt "$n" ]; do
    a="$1"
    shift
    case "$a" in
        "$orig"/*)
            set -- "$@" "$patched/${a#"$orig"/}"
            ;;
        *.comp | *.glsl)
            case "$a" in
                "$patched"/*)
                    set -- "$@" "$a"
                    ;;
                *)
                    echo "skein-glslc: refusing to compile a shader source from outside" >&2
                    echo "  the patched tree (bd skein-ylux):" >&2
                    echo "    argument: $a" >&2
                    echo "    expected under: $patched" >&2
                    echo "  See native/llama/CMakeLists.txt section 5a." >&2
                    exit 90
                    ;;
            esac
            ;;
        *)
            set -- "$@" "$a"
            ;;
    esac
    i=$((i + 1))
done

exec '@SKEIN_GLSLC_REAL@' "$@"
