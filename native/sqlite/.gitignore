# Source tarballs — fetched by CMake at build time, don't commit
third_party/*.tar.gz

# Extracted upstream source trees for SQLCipher (used only to regenerate the
# amalgamation) and OpenSSL (used only to build libcrypto.a during the Gradle
# externalNativeBuild). Both are regenerated from tarballs by the reproducible
# build recipe, so we don't commit their extracted contents.
third_party/sqlcipher-*/
third_party/openssl-*/

# sqlite-vec is VENDORED in-tree: sqlite-vec.c + generated sqlite-vec.h + the
# licenses are checked in under third_party/sqlite-vec-0.1.9/ so the CMake
# build can compile sqlite-vec statically without a network fetch. See
# README.md §2 for the sed pass that produces sqlite-vec.h from the .tmpl.
!third_party/sqlite-vec-0.1.9/
!third_party/sqlite-vec-0.1.9/sqlite-vec.c
!third_party/sqlite-vec-0.1.9/sqlite-vec.h
!third_party/sqlite-vec-0.1.9/LICENSE-APACHE
!third_party/sqlite-vec-0.1.9/LICENSE-MIT

# Build outputs (already caught by top-level .gitignore; explicit for clarity)
build/
host-build/
prebuilt/

# ExternalProject_Add scratch space for the OpenSSL build.
openssl-build/
