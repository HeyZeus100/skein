# Android / Gradle
*.iml
.gradle/
.kotlin/
local.properties
.idea/
.DS_Store
build/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.dex
# Repo-root staging dir for signed release artifacts (e.g. `sign.sh
# --out release/skein-1.0.0-foss.apk`) -- anchored to root so it doesn't
# also match tools/release/ (the signing scripts themselves, which are
# tracked).
/release/

# Native
*.so
*.a
*.o
llama.cpp/build/
tools/**/build/

# Kotlin / JVM
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar
hs_err_pid*
replay_pid*

# Model files (never checked in — always downloaded via SAF, hash-verified)
*.gguf
*.task
*.litertlm
*.onnx
*.safetensors
*.bin
/models/

# skein-80p (E4.I2): the tiny GGUF `fetchTestModel` downloads for
# LlamaNativeTest -- already covered by the `*.gguf` rule above; named
# explicitly so it's obvious this is deliberate. See tools/models/README.md.
inference-service/src/androidTest/assets/

# Vault / test data
vault.db*
*.sqlite*
attachments/
.superpowers/

# Benchmark output — per-run cells are gitignored, but the baseline
# artifact area is preserved in git (immutable per hardware-lab freeze).
tools/m0-benchmark/output/
!tools/m0-benchmark/output/baseline/
!tools/m0-benchmark/output/baseline/**
MEASUREMENTS.md.bak

# Secrets — never checked in
*.jks
*.keystore
signing.properties
*.pem
*.key
!**/public.pem

# Editor / OS
.vscode/
.env
.env.local
*.swp
*~
Thumbs.db

# bd (local db committed; caches ignored)
.beads/cache/
.beads/*.wal
.beads/*.shm

# Node (if any tooling ends up needing it)
node_modules/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Local benchmark / device baseline output (agents produce these while working)
device-baseline.txt

# sqlite-vec upstream source tree — we vendor only the .c/.h/LICENSE-* files
# (see native/sqlite/third_party/sqlite-vec-0.1.9/ tracked contents); the rest
# of the upstream tarball leaks in during SQLCipher build regeneration.
native/sqlite/third_party/sqlite-vec-*/.github/
native/sqlite/third_party/sqlite-vec-*/.gitignore
native/sqlite/third_party/sqlite-vec-*/ARCHITECTURE.md
native/sqlite/third_party/sqlite-vec-*/Makefile
native/sqlite/third_party/sqlite-vec-*/README.md
native/sqlite/third_party/sqlite-vec-*/SECURITY.md
native/sqlite/third_party/sqlite-vec-*/TODO
native/sqlite/third_party/sqlite-vec-*/VERSION
native/sqlite/third_party/sqlite-vec-*/benchmarks/
native/sqlite/third_party/sqlite-vec-*/bindings/
native/sqlite/third_party/sqlite-vec-*/examples/
native/sqlite/third_party/sqlite-vec-*/reference.yaml
native/sqlite/third_party/sqlite-vec-*/scripts/
native/sqlite/third_party/sqlite-vec-*/site/
native/sqlite/third_party/sqlite-vec-*/tests/
native/sqlite/third_party/sqlite-vec-*/vendor/
native/sqlite/third_party/sqlite-vec-*/sqlite-dist.toml
native/sqlite/third_party/sqlite-vec-*/sqlite-vec.h.tmpl
native/sqlite/third_party/sqlite-vec-*/test.sql
native/sqlite/third_party/sqlite-vec-*/tmp-static.py

# Reference clones for reconnaissance (bd epic skein-rkrq): pinned by SHA in the
# analysis documents, never committed. Clones live under research/clones/<name>/;
# the tracked analyses live under research/upstream/<name>/ (OfflineLLM directive).
research/clones/

# Per-worktree agent build logs (never /tmp; see bd memory agent-logs-not-in-tmp)
.agent-logs/
